# Copy to .env (git-ignored) and fill in. Never commit real values.

# Your NVIDIA NIM API key (build.nvidia.com). Backend only; never sent to the browser.
NVIDIA_API_KEY=

# "nim" (real model) or "demo" (offline rule-based model, no key needed)
CHOTU_PROVIDER=nim

# Default model; must be listed in config/models.json
CHOTU_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Local port for the app (default 8765)
CHOTU_PORT=8765

# SQLite file (relative paths are resolved from the repo root)
CHOTU_DB_PATH=data/chotubot.sqlite3

# Optional LangSmith tracing. OFF by default. When on, message/tool content is redacted.
CHOTU_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
