# Copy to .env (git-ignored) and fill in. Never commit real values.

# Your personal OpenRouter key. Backend only; never sent to the browser.
OPENROUTER_API_KEY=

# NVIDIA NIM key (testing provider, CHOTU_PROVIDER=nim). Backend only.
NVIDIA_API_KEY=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

# Model provider: "openrouter" (default), "nim" (NVIDIA NIM, free-tier testing) or "demo" (offline, no API).
CHOTU_PROVIDER=openrouter

# Default model id; must be listed in config/models.json
CHOTU_DEFAULT_MODEL=openai/gpt-5-nano   # for nim use nvidia/nemotron-3.5-lightning-30b-a3b

# Budget guard. Estimates only - not provider billing totals.
CHOTU_MONTHLY_BUDGET_INR=300
# Fixed USD->INR rate used to convert OpenRouter's USD cost. SET THIS to the current rate.
CHOTU_USD_TO_INR=90.0

# SQLite file (relative paths are resolved from the repo root)
CHOTU_DB_PATH=data/chotubot.sqlite3

# Optional LangSmith tracing. OFF by default. When on, message/tool content is redacted.
CHOTU_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
