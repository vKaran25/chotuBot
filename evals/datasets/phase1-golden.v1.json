{
  "dataset": "phase1-golden",
  "version": "1.0.0",
  "description": "Phase 1 golden cases. 'frozen_model' holds the scripted provider responses used for deterministic runs. 'expected' is the ground truth the owner must review. Fixtures: evals/fixtures/.",
  "review_policy": "Every case stays 'PENDING HUMAN REVIEW' until the owner sets review.status to REVIEWED with reviewer and reviewed_at. Agents never mark cases reviewed. The eval runner uses the key sentinel sk-or-v1-EVAL-SENTINEL-0000000000 for cases whose key is configured.",
  "cases": [
    {
      "id": "basic-01",
      "category": "basic_conversation",
      "description": "Greeting needs no tool.",
      "request": {
        "message": "Hello!"
      },
      "frozen_model": [
        {
          "content": "Hello! How can I help you today?",
          "input_tokens": 40,
          "output_tokens": 12,
          "cost_usd": 2e-05
        }
      ],
      "expected": {
        "http_status": 200,
        "error_code": null,
        "tool_calls": [],
        "response_contains": [
          "help"
        ]
      },
      "review": {
        "status": "PENDING HUMAN REVIEW",
        "reviewer": null,
        "reviewed_at": null,
        "notes": ""
      }
    },
    {
      "id": "basic-02",
      "category": "basic_conversation",
      "description": "General knowledge answered directly.",
      "request": {
        "message": "What is the capital of France?"
      },
      "frozen_model": [
        {
          "content": "The capital of France is Paris.",
          "input_tokens": 40,
          "output_tokens": 12,
          "cost_usd": 2e-05
        }
      ],
      "expected": {
        "http_status": 200,
        "error_code": null,
        "tool_calls": [],
        "response_contains": [
          "Paris"
        ]
      },
      "review": {
        "status": "PENDING HUMAN REVIEW",
        "reviewer": null,
        "reviewed_at": null,
        "notes": ""
      }
    },
